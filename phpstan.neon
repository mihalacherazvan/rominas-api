includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    paths:
        - app

    # Barryvdh ide-helper model stubs — provide model property/method types so the
    # `@mixin IdeHelper*` tags resolve. Regenerate with `php artisan ide-helper:models`.
    scanFiles:
        - _ide_helper_models.php

    tmpDir: build/phpstan
